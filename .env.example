# CurrentsAPI key — sign up free at https://currentsapi.services
# Used by src/api/newsApi.ts to populate the Daily Bugle sidebar / overlay / /bugle page.
# Copy this file to .env.local and replace the placeholder.
# (.env.local is already gitignored via the *.local rule in .gitignore.)
VITE_CURRENTS_API_KEY=your-key-here

# GitHub username — used by src/api/githubApi.ts to populate the Spider-Suit
# HUD telemetry (commits this week, total stars, open issues, current streak).
# Public REST API, no token required. Unauthenticated cap: 60 req/hr per IP.
VITE_GITHUB_USERNAME=samrht

# Weather city — used by src/api/weatherApi.ts for the HUD AtmosPanel via
# Open-Meteo. The city name is geocoded once per session; no API key required.
VITE_WEATHER_CITY=New York
